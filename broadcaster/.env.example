# Telegram API Credentials (Get these free from https://my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here

# Telethon session file name (persists your login so you only verify once)
SESSION_NAME=stock_broadcaster

# Supplier chats to listen to (comma-separated channel usernames or bot usernames)
# Example: @supplier_alerts_channel,@supplier_bot
SOURCE_CHATS=@supplier_channel,@supplier_bot

# Destination channel or group where you want to post your marked-up alerts
# Example: @my_store_channel
DESTINATION_CHANNEL=@my_store_channel

# Your bot username (for the "Open item" / "Shop" button link)
MY_BOT_USERNAME=creditlog_bot

# Default button label (optional)
BUTTON_LABEL=🛍️ Open item
