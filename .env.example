# ==============================================================================
# Telegram Reseller Store Bot Configuration
# ==============================================================================

# --- Telegram Bot ---
BOT_TOKEN=123456:replace-with-token-from-BotFather
ADMIN_IDS=111111111,222222222        # comma-separated Telegram user IDs of bot admins
SUPPORT_URL=https://t.me/your_support
CHANNEL_URL=https://t.me/your_channel

# --- Store Settings ---
LOW_STOCK=2                           # alert admins when manual stock falls to or below this count

# --- Digital Goods Reseller Catalog API ---
RESELLER_BASE_URL=https://api-geminipro.ignorelist.com/api/reseller/v1
RESELLER_API_KEY=your_reseller_api_key_here
RESELLER_MARKUP_PERCENT=20            # default profit markup % when syncing catalog (/s_sync)

# --- Payment Gateway (NOWPayments Crypto) ---
# Optional: leave blank to enable Direct Fulfillment mode (instant free test checkouts)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
PUBLIC_URL=https://shop.example.com   # public HTTPS URL for receiving IPN webhooks

# --- Deployment & Server ---
DOMAIN=shop.example.com               # domain used by Caddy for automatic HTTPS
PORT=8080                             # webhook/health HTTP server port
DB_PATH=store.db                      # SQLite database file path
