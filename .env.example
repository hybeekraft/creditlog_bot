# Telegram Bot Configuration
# Bot token from @BotFather
BOT_TOKEN=123456:replace-with-token-from-BotFather

# Store admin Telegram IDs (comma-separated, get your ID from @userinfobot)
ADMIN_IDS=111111111,222222222

# Support and channel links shown in menus
SUPPORT_URL=https://t.me/your_support
CHANNEL_URL=https://t.me/your_channel

# Channels/groups users must join before using the bot (bot must be admin)
REQUIRED_CHANNELS=@Aristocrticc,@geminiupdate

# Low stock alert threshold for local stock items
LOW_STOCK=2

# Crypto Payments
CRYPTOBOT_TOKEN=token-from-@CryptoBot
BINANCE_PAY_ID=76177351

# Default USDT wallet addresses
CRYPTO_USDT_BEP20=0xe37301d1cb7E1d479a1F1A78d6A2EAed317412Db
CRYPTO_USDT_TRC20=TUaDYfZ2fBRXSRDm9d6kN9j2J7bi7ZsBLW

# Supplier Catalog API
RESELLER_BASE_URL=https://api-vendor.com/api/reseller/v1
RESELLER_API_KEY=

# Additional suppliers (optional):
# SUPPLIER_VENDOR2_URL=https://api-vendor2.com/api/reseller/v1
# SUPPLIER_VENDOR2_KEY=your_vendor2_api_key

# Default profit markup on wholesale supplier products
PROFIT_MARGIN=45%

# Direct Bank Transfer (Naira)
USD_NGN_RATE=1450
BANK_NAME=OPay
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=

# Bachs Payment Gateway (Cards, Bank Transfer, Mobile Money, Crypto)
# Get your API key from https://app.bachs.io
BACHS_API_KEY=
BACHS_CURRENCY=USD
# Optional callback override (leave blank to automatically return buyers to Telegram)
BACHS_CALLBACK_URL=

# Server & Deployment
DOMAIN=shop.example.com
PORT=8080
DB_PATH=store.db

# Brand Custom Emojis (optional, or use /setemoji in chat)
# EMOJI_CHATGPT=5368324170671202288
# EMOJI_GEMINI=5449764528151603597
