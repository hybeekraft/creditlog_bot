# ==============================================================================
# Telegram Reseller Store Bot - Environment Configuration (.env.example)
# Guest checkout model with automated supplier catalog integration
# ==============================================================================

# --- Telegram Bot Configuration ---
# 1. Create a bot with @BotFather and paste the token here
BOT_TOKEN=123456:replace-with-token-from-BotFather

# 2. Comma-separated Telegram User IDs for store admins (get ID from @userinfobot)
ADMIN_IDS=111111111,222222222

# 3. Customer support link and news channel link shown in the main menu
SUPPORT_URL=https://t.me/your_support
CHANNEL_URL=https://t.me/your_channel

# --- Store Settings ---
LOW_STOCK=2                           # Alert admins when local stock falls to or below this count

# --- Crypto Payments ---
CRYPTOBOT_TOKEN=token-from-@CryptoBot
BINANCE_PAY_ID=your_binance_pay_id

# --- USDT Addresses ---
CRYPTO_USDT_BEP20=0xYourBscAddress
CRYPTO_USDT_TRC20=TYourTronAddress

# --- Reseller API Integration ---
RESELLER_API_KEY=
RESELLER_BASE_URL=https://api-geminipro.ignorelist.com/api/reseller/v1

# --- Profit Margin (default 45%) ---
PROFIT_MARGIN=45%

# --- Production Deployment (Docker + Caddy Automatic HTTPS) ---
DOMAIN=shop.example.com               # Your domain pointing to VPS (used by Caddy for SSL)
PORT=8080                             # Internal HTTP server port for webhooks & health checks
DB_PATH=store.db                      # SQLite database file path
